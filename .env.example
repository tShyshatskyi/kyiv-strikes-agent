# Copy this file to .env and fill it in. Copy — do not rename: .env is ignored
# by git, and this example has to stay in the repository.

# Model access — used by the AGENT only. The MCP server never reads any of this
# and runs perfectly well without it.
#
# Any OpenAI-compatible endpoint works; pick one and fill in all three.
#
#   OpenRouter (course-provided or your own):
#     OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
#     OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
#
#   Google AI Studio, free tier:
#     OPENROUTER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#     OPENROUTER_MODEL=gemini-2.0-flash
#
#   Local Ollama, no key needed (put any non-empty string in the key):
#     OPENROUTER_BASE_URL=http://localhost:11434/v1
#     OPENROUTER_MODEL=llama3.1:8b
OPENROUTER_API_KEY=REPLACE_ME
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Required by the Nominatim usage policy: a real contact address, sent in the
# User-Agent of every geocoding request.
NOMINATIM_CONTACT=your.email@example.com

# 1 replays the recorded Nominatim responses in fixtures/nominatim instead of
# calling the network. Only the transport changes; parsing, validation and the
# district point-in-polygon check run identically either way.
KSM_OFFLINE=0

# Where the incident database lives.
KSM_DB_PATH=incidents.sqlite

# Optional. 1 silences the agent's progress lines; WARNING keeps the MCP
# server's per-request logging out of the way (set DEBUG to see it).
# KSM_QUIET=0
# KSM_LOG_LEVEL=WARNING
