# Model access — used by the AGENT only. The MCP server never reads any of this
# and runs perfectly well without it.
#
# Any OpenAI-compatible endpoint works; pick one and fill in all three.
#
#   OpenRouter (course-provided or your own):
#     OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
#     OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
#
#   Google AI Studio, free tier:
#     OPENROUTER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#     OPENROUTER_MODEL=gemini-2.0-flash
#
#   Local Ollama, no key needed (put any non-empty string in the key):
#     OPENROUTER_BASE_URL=http://localhost:11434/v1
#     OPENROUTER_MODEL=llama3.1:8b
OPENROUTER_API_KEY=REPLACE_ME
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Required by the Nominatim usage policy: a real contact address.
NOMINATIM_CONTACT=your.email@example.com

# Set to 1 to replay recorded Nominatim fixtures instead of calling the network.
KSM_OFFLINE=0

# Path to the incident database.
KSM_DB_PATH=incidents.sqlite
